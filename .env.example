# ========================================
# SUPABASE
# ========================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ========================================
# DATABASE
# ========================================
# Transaction pooler (Prisma Client)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler (Migrations)
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# ========================================
# API KEYS (Optional - graceful degradation)
# ========================================
# Anthropic API (optional - for direct Claude calls)
ANTHROPIC_API_KEY=

# OpenRouter (recommended - multi-model support)
OPENROUTER_API_KEY=

# Langfuse (optional - LLM observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# PortOne (optional - payment processing)
# Requires Korean business registration
PORTONE_SHOP_ID=
PORTONE_API_KEY=
PORTONE_API_SECRET=

# ========================================
# SERVER URLs
# ========================================
# Backend API (Fastify)
NEXT_PUBLIC_API_URL=http://localhost:3000
API_URL=http://localhost:3000

# AI Server (FastAPI)
AI_SERVER_URL=http://localhost:8000
NEXT_PUBLIC_AI_SERVER_URL=http://localhost:8000

# Frontend (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ========================================
# DEVELOPMENT
# ========================================
NODE_ENV=development
PORT=3000
AI_SERVER_PORT=8000
