# ========================================
# SUPABASE
# ========================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ========================================
# DATABASE
# ========================================
# Transaction pooler (Prisma Client)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler (Migrations)
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# ========================================
# API KEYS (Optional - graceful degradation)
# ========================================
# Anthropic API (optional - for direct Claude calls)
ANTHROPIC_API_KEY=

# OpenRouter (recommended - multi-model support)
OPENROUTER_API_KEY=

# Langfuse (optional - LLM observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# PortOne (optional - payment processing)
# Requires Korean business registration
PORTONE_API_KEY=
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# ========================================
# SERVER URLs
# ========================================
# Backend API (Fastify)
NEXT_PUBLIC_API_URL=http://localhost:3000
API_URL=http://localhost:3000

# AI Server (FastAPI)
AI_SERVER_URL=http://localhost:8000

# Frontend (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ========================================
# DEVELOPMENT
# ========================================
NODE_ENV=development
PORT=3000
AI_SERVER_PORT=8000

# ========================================
# FEATURE FLAGS
# ========================================
# Regenerate gem cost multiplier (1.0 = same cost, 0.0 = free)
REGENERATE_GEM_COST_MULTIPLIER=1.0

# ========================================
# PRODUCTION DEPLOYMENT (Docker)
# ========================================
# New Relic APM (optional - application monitoring)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME_API=PersonaChat-API
NEW_RELIC_APP_NAME_AI=PersonaChat-AI

# Public deployment URLs (replace localhost with your server IP/domain)
# Example for AWS EC2: http://52.63.157.14:3000
# NEXT_PUBLIC_API_URL=http://YOUR_PUBLIC_IP:3000
# NEXT_PUBLIC_APP_URL=http://YOUR_PUBLIC_IP:3001
