# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your-anon-key...

# PortOne Configuration (for payments)
# 테스트 모드: store-test, channel-key-test 사용 시 실제 결제 없이 플로우만 테스트
# 실제 결제: PortOne 콘솔에서 발급받은 실제 Store ID와 Channel Key 사용
NEXT_PUBLIC_PORTONE_STORE_ID=store-test
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-test
