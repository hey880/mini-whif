// Persona Chat Database Schema
// Optimized for Supabase Postgres with best practices

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTH & USER PROFILE
// ============================================

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  displayName String @map("display_name")
  avatarUrl String?  @map("avatar_url")
  bio       String?  @db.Text
  chosenLlmModelId String? @map("chosen_llm_model_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  chosenLlmModel LlmModel?  @relation(fields: [chosenLlmModelId], references: [id], onDelete: SetNull)
  characters     Character[]
  personas       UserPersona[]
  chatRooms      ChatRoom[]
  gemWallet      GemWallet?
  gemLogs        GemLog[]
  gemOrders      GemOrder[]
  userReactions  UserReaction[]

  @@index([email])
  @@map("profiles")
}

// ============================================
// LLM MODELS
// ============================================

model LlmModel {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String   @unique
  provider        String
  contextWindow   Int      @map("context_window")
  maxOutputTokens Int      @map("max_output_tokens")
  gemCostPerMessage Int    @map("gem_cost_per_message")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  profilesUsingModel Profile[]

  @@index([isActive])
  @@index([slug])
  @@map("llm_models")
}

// ============================================
// GEM WALLET & TRANSACTIONS
// ============================================

model GemWallet {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String    @unique @map("user_id") @db.Uuid
  paidGemAmount            Int       @default(0) @map("paid_gem_amount")
  freeDailyGemAmount       Int       @default(200) @map("free_daily_gem_amount")
  freePromoGemAmount       Int       @default(0) @map("free_promo_gem_amount")
  freeDailyGemLastRefillDate DateTime? @map("free_daily_gem_last_refill_date") @db.Date
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gem_wallets")
}

model GemLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  amount           Int
  gemType          String   @map("gem_type") // paid, free_daily, free_promo
  logType          String   @map("log_type") // chat_message, purchase, refund, daily_refill, promo_grant, admin_adjustment
  relatedOrderId   String?  @map("related_order_id") @db.Uuid
  relatedMessageId String?  @map("related_message_id") @db.Uuid
  memo             String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user          Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedOrder  GemOrder? @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedMessage Message? @relation(fields: [relatedMessageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([logType])
  @@index([relatedOrderId])
  @@index([relatedMessageId])
  @@map("gem_logs")
}

model GemOrder {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  productId            String    @map("product_id")
  gemAmount            Int       @map("gem_amount")
  currency             String    @default("KRW")
  priceAmount          Int       @map("price_amount")
  paymentStatus        String    @map("payment_status") // pending, paid, failed, refunded
  paymentMethod        String?   @map("payment_method")
  paymentTransactionId String?   @map("payment_transaction_id")
  paidAt               DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gemLogs GemLog[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([paymentStatus])
  @@index([paymentTransactionId])
  @@map("gem_orders")
}

// ============================================
// CHARACTERS & UNIVERSES
// ============================================

model Universe {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  characters Character[]

  @@map("universes")
}

model Character {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  tagline         String?
  description     String?  @db.Text
  greeting        String?  @db.Text
  imageUrl        String?  @map("image_url")
  bannerImageUrl  String?  @map("banner_image_url")
  visibility      String   @default("public") // public, private, unlisted
  isNsfw          Boolean  @default(false) @map("is_nsfw")
  creatorId       String   @map("creator_id") @db.Uuid
  universeId      String?  @map("universe_id") @db.Uuid
  keywords        String[] @default([])
  data            Json     @default("{}")
  lorebook        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  creator   Profile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  universe  Universe?  @relation(fields: [universeId], references: [id], onDelete: SetNull)
  chatRooms ChatRoom[]

  // GIN index for array search
  @@index([keywords], type: Gin)
  @@index([creatorId])
  @@index([visibility, isNsfw])
  @@index([universeId])
  @@index([createdAt(sort: Desc)])
  @@map("characters")
}

// ============================================
// USER PERSONAS
// ============================================

model UserPersona {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  persona   String   @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user      Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatRooms ChatRoom[]

  @@index([userId])
  @@index([userId, isDefault])
  @@map("user_personas")
}

// ============================================
// CHAT ROOMS & MESSAGES
// ============================================

model ChatRoom {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  characterId         String    @map("character_id") @db.Uuid
  personaId           String?   @map("persona_id") @db.Uuid
  userNote            String?   @map("user_note") @db.Text
  conversationSummary String?   @map("conversation_summary") @db.Text
  lastMessageAt       DateTime? @map("last_message_at") @db.Timestamptz(6)
  isPinned            Boolean   @default(false) @map("is_pinned")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  persona   UserPersona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([userId, isPinned])
  @@index([characterId])
  @@index([personaId])
  @@map("chat_rooms")
}

model Message {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId                 String   @map("room_id") @db.Uuid
  role                   String   // user, assistant, system
  content                String   @db.Text
  modelSlug              String?  @map("model_slug")
  versionNumber          Int      @default(1) @map("version_number")
  parentMessageId        String?  @map("parent_message_id") @db.Uuid
  positiveReactionCount  Int      @default(0) @map("positive_reaction_count")
  negativeReactionCount  Int      @default(0) @map("negative_reaction_count")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  room           ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  parentMessage  Message?        @relation("MessageVersions", fields: [parentMessageId], references: [id], onDelete: Cascade)
  versions       Message[]       @relation("MessageVersions")
  messageVersions MessageVersion[]
  userReactions  UserReaction[]
  gemLogs        GemLog[]

  @@index([roomId, createdAt])
  @@index([parentMessageId])
  @@map("messages")
}

model MessageVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId     String   @map("message_id") @db.Uuid
  content       String   @db.Text
  versionNumber Int      @map("version_number")
  modelSlug     String?  @map("model_slug")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, versionNumber])
  @@index([messageId])
  @@map("message_versions")
}

model UserReaction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  reactionType String   @map("reaction_type") // positive, negative
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([messageId])
  @@map("user_reactions")
}

// ============================================
// KEYWORDS (Popular Search Terms)
// ============================================

model Keyword {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyword   String   @unique
  category  String?
  usageCount Int     @default(0) @map("usage_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([usageCount(sort: Desc)])
  @@map("keywords")
}
