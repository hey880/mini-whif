{
  "name": "@persona-chat/proto",
  "version": "1.0.0",
  "private": true,
  "description": "Protocol Buffers and ConnectRPC generated code",
  "type": "module",
  "main": "./gen/ts/index.js",
  "types": "./gen/ts/index.d.ts",
  "exports": {
    ".": {
      "import": "./gen/ts/index.js",
      "types": "./gen/ts/index.d.ts"
    },
    "./gen/ts/*": "./gen/ts/*"
  },
  "files": [
    "gen"
  ],
  "scripts": {
    "generate": "buf generate",
    "build": "tsc",
    "lint": "echo 'Skipping buf lint - proto files are auto-generated'",
    "type-check": "tsc --noEmit",
    "format": "buf format -w"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.32.0",
    "@bufbuild/protoc-gen-es": "^1.10.0",
    "@connectrpc/protoc-gen-connect-es": "^1.4.0",
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.4.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.4.0"
  }
}
