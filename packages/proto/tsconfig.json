{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "./gen/ts",
    "rootDir": "./gen/ts",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "allowJs": true,
    "noEmit": false
  },
  "include": ["gen/ts/**/*.ts"],
  "exclude": ["node_modules"]
}
